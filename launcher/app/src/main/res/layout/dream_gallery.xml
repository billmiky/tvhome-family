<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver (GalleryDream): photos from Pictures/Launcher with a slow pan and zoom, and a small
     clock, date and weather in the bottom right corner. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- The two photo views are added here in code, crossfading over each other. -->
    <FrameLayout
        android:id="@+id/dreamPhotos"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Darker towards the bottom so the clock reads on bright photos. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_gravity="bottom"
        android:background="@drawable/dream_scrim" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="64dp"
        android:layout_marginBottom="48dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="#F2FFFFFF"
            android:textSize="64sp"
            android:fontFamily="@string/font_body"
            android:fontVariationSettings="'wght' 300"
            android:letterSpacing="-0.03"
            android:includeFontPadding="false"
            android:shadowColor="#B3000000"
            android:shadowRadius="10"
            android:shadowDy="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="@string/date_format"
                android:format24Hour="@string/date_format"
                android:textColor="#CCFFFFFF"
                android:textSize="16sp"
                android:fontFamily="@string/font_body"
                android:fontVariationSettings="'wght' 400"
                android:letterSpacing="0.14"
                android:textAllCaps="true"
                android:shadowColor="#B3000000"
                android:shadowRadius="8"
                android:shadowDy="1" />

            <TextView
                android:id="@+id/dreamWeather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:textColor="#CCFFFFFF"
                android:textSize="16sp"
                android:fontFamily="@string/font_body"
                android:fontVariationSettings="'wght' 400"
                android:letterSpacing="0.06"
                android:shadowColor="#B3000000"
                android:shadowRadius="8"
                android:shadowDy="1"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
