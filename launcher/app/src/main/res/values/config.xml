<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Edit this file, then run launcher/build-and-install.sh.
  Or leave it and push a theme instead: tools/theme.sh themes/<name> puts a config.json (same keys, see
  themes/README.md) and an optional wallpaper on the TV, and the launcher overlays it at start.
  Package names: on the TV run `pm list packages` (tools/tv.py 'pm list packages').
-->
<resources>

    <!-- Apps pinned to the dock row at the bottom, in this order. Missing apps are skipped. -->
    <string-array name="dock_apps">
        <item>com.netflix.ninja</item>
        <item>com.amazon.amazonvideo.livingroom</item>
        <item>com.google.android.youtube.tv</item>
        <item>in.startv.hotstar</item>
    </string-array>

    <!-- Apps never shown as tiles (e.g. the Live TV app, which the Inputs menu already covers). -->
    <string-array name="hidden_apps">
        <item>com.mediatek.wwtv.tvcenter</item>
        <item>com.mitv.gallery</item>
    </string-array>

    <!-- The TV's Live TV / tuner app, offered at the end of the Inputs menu. Leave empty to omit. -->
    <string name="live_tv_package" translatable="false">com.mediatek.wwtv.tvcenter</string>

    <!-- Some TVs give their Live TV app no leanback entry point at all, so `live_tv_package` above
         resolves to nothing (TCL Android TV 9 on China-market sets is one). This action is then sent
         to that package instead, and the app starts normally. Leave empty to omit. -->
    <string name="live_tv_action" translatable="false"></string>

    <!-- TVs with no TvInputManager have no HDMI list to read, but their own source-selection panel
         still switches inputs (TCL Android TV 9 again). When nothing could be listed, the Inputs menu
         offers one row that starts this service: component first, then action. Leave empty to omit. -->
    <string name="source_panel_service" translatable="false"></string>
    <string name="source_panel_action" translatable="false"></string>

    <!-- Inputs menu: HDMI and AV rows normally open with ACTION_VIEW on the input's channel URI, which the
         Live TV app handles. Where nothing answers that, this action is sent with the same URI instead
         (XGIMI projectors: com.xgimi.action.hdmiPlayer). Leave empty to omit. -->
    <string name="input_action" translatable="false"></string>

    <!-- Show the Solar Hijri (Shamsi) date used in Iran and Afghanistan, e.g. "27 Mehr 1405", above the
         Gregorian date. -->
    <bool name="shamsi_date">false</bool>
    <!-- Optional VPN app the network pill opens (hold the pill for Wi-Fi settings), e.g. the package of the
         VPN you use. Empty: the pill opens Wi-Fi settings. The green VPN badge shows for any VPN either way;
         with an app set here, a red "VPN off" badge also shows while no VPN is up. -->
    <string name="vpn_app" translatable="false"></string>
    <!-- Grid rows left visible under the dock on the home screen. 0 = dock sits at the very bottom. -->
    <integer name="rows_below_dock">0</integer>

    <!-- Tiles per row in the grid; the dock always has this many slots. Tiles are 180dp wide at 4 columns and
         shrink to fit from 5 up (about 144dp at 5, 117dp at 6 on a 1080p TV). -->
    <integer name="columns">4</integer>

    <!-- "Default home" tile that opens Android's home-screen picker, for TVs whose settings have one
         (most Android TVs don't; the tile only appears when the page exists). Off by default. -->
    <bool name="show_home_settings_shortcut">false</bool>

    <!-- Module cards: an app that declares a card (docs/specs/card.md) can stand in for its tile with its own
         label, caption and glow colour, once you answer Show on the prompt. false: never look for cards or ask. -->
    <bool name="module_cards">true</bool>

    <!-- Self-update (docs/specs/self-update.md), official builds only: weekly = check once a week and ask
         before installing; manual = only when you choose "Check for updates" (hold OK on Settings);
         off = never contact the update server. A launcher built on your computer has no update feed
         and ignores this. -->
    <string name="self_update" translatable="false">weekly</string>

    <!-- A name after the greeting: "Mr. Trịnh" shows GOOD MORNING, MR. TRỊNH. Empty: the greeting alone. -->
    <string name="greeting_name" translatable="false"></string>

    <!-- Now playing: a card above the dock for the app playing in the background (YouTube Music, Spotify…),
         with play/pause, previous and next. Needs the notification listener the install script enables;
         without it the card never shows. false: never look. -->
    <bool name="now_playing">true</bool>

    <!-- Gallery: your photos from Pictures/Launcher on the TV as the Home background, a random one every five
         minutes, over the theme wallpaper. Needs permission to read photos (the install script grants it, or
         the TV asks when you switch Gallery on). Off by default; also switched on the TV: hold OK on
         Settings, then Gallery. -->
    <bool name="gallery">false</bool>

    <!-- Bitcoin price and 24 hour change above the top buttons, refreshed every five minutes
         while Home is in front (api.coinbase.com, api.exchange.coinbase.com). Off by default;
         also switched on the TV: hold OK on Settings, then Bitcoin price. -->
    <bool name="btc_ticker">false</bool>

    <!-- Weather next to the date: an icon and the temperature now, from Open-Meteo (no account, no key),
         refreshed every 30 minutes while Home is in front. Off by default; also switched on the TV: hold OK
         on Settings, then Weather. weather_location is "lat,lon" (e.g. "1.29,103.85") or a place name
         ("Singapore"), looked up once on geocoding-api.open-meteo.com. Empty: no weather. -->
    <bool name="weather">false</bool>
    <string name="weather_location" translatable="false"></string>
    <!-- celsius or fahrenheit -->
    <string name="weather_unit" translatable="false">celsius</string>

    <!-- Gallery screensaver (pick "Gallery" as the screensaver): seconds each photo stays, 10 to 600. -->
    <integer name="screensaver_interval_s">30</integer>

    <!-- Phone control (WebControl): a page on the home network for Gallery photos and a few switches, at
         http://<TV address>:web_port/ with a 6-digit code (hold OK on the network pill shows the link).
         Only answers addresses on the local network. false: no server at all. -->
    <bool name="web_control">true</bool>
    <integer name="web_port">8080</integer>

    <!-- Phone remote over the internet (RemoteRelay): the relay Worker in relay/ of this repo. With it set, the
         QR code in the network menu (hold OK on the network pill) pairs a phone that can show a message on the
         TV and switch it off and on from anywhere. https:// only; empty: no connection at all. -->
    <string name="remote_relay" translatable="false">https://tv-remote.ptrinh.workers.dev</string>

    <!-- Occasions: days the greeting line (above the clock) says something else, as a JSON array of
         {"date": "MM-DD" every year or "YYYY-MM-DD" once, "text": "…", "video": optional YouTube link}, e.g.
         [{\"date\": \"03-14\", \"text\": \"Happy birthday, bé An\"}] (Android string resources drop
         unescaped double quotes, hence the backslashes). Up to 50, text up to 48 characters. In a theme's
         config.json write the plain array instead. The phone page can also edit them. -->
    <string name="occasions" translatable="false">[]</string>
    <!-- Built-in holidays when no occasion of yours is set that day: Christmas, 24 and 25 December (MERRY
         CHRISTMAS 🎄 🎅); New Year, 31 December and 1 January (HAPPY NEW YEAR 🍾 🎉); Tết, three days before
         mùng 1 to five days after (HAPPY NEW YEAR 🧧 🎉). -->
    <bool name="holidays">true</bool>
    <!-- On an occasion day a Play card stands in for Now playing and plays a song on YouTube: the occasion's
         own "video", else a search (Happy Birthday song for birthdays). These pick a video for the built-in
         holidays instead of a search: a YouTube link or 11-character video id; empty searches for the song. -->
    <string name="christmas_video" translatable="false"></string>
    <string name="new_year_video" translatable="false"></string>
    <string name="tet_video" translatable="false"></string>
</resources>
